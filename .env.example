# ==============================================================================
# CARDWATCH ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to `.env` or `.env.local` for local development.
# NEVER commit production secrets or service role keys to source control.
# ==============================================================================

# Public Supabase Project URL (Safe for client-side frontend code)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public Supabase Anonymous Key (Safe for client-side frontend code; protected by RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Google Gemini API Key for CARDWATCH AI live intelligence
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Sovereign Admin Vault SHA-256 Digest (never store raw passkey with VITE_ prefix)
VITE_ADMIN_KEY_HASH=salted_sha256_hash_here

# ==============================================================================
# SERVER-SIDE ONLY VARIABLES (NEVER expose to Vite frontend with VITE_ prefix!)
# ==============================================================================
# CARDWATCH_ADMIN_KEY=your_raw_master_key_saved_locally
# CARDWATCH_ADMIN_KEY_HASH=salted_sha256_hash_here
# SUPABASE_SERVICE_ROLE_KEY=ey... (Server / CI/CD only, bypasses RLS)
# DATABASE_URL=postgresql://postgres:...@db.your-project.supabase.co:5432/postgres
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG...
